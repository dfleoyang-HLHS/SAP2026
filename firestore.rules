rules_version = '2';

// 數位前導指南診斷：Firestore 安全規則
// 每所學校一個工作區，工作區的 id 就是學校 Google 帳號的網域（例如 hlhs.hlc.edu.tw）。
// 第一位登入的成員建立工作區後，同網域的帳號都能讀寫；其他網域的帳號看不到。
// 只接受網域結尾為 edu.tw 的學校帳號；要改成其他結尾時，同時修改 config.js 的 allowedSuffix。
service cloud.firestore {
  match /databases/{database}/documents {

    function schoolAccount() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@([a-z0-9-]+[.])*edu[.]tw$');
    }
    function userDomain() {
      return request.auth.token.email.lower().split('@')[1];
    }
    function sameSchool(domain) {
      return schoolAccount() && userDomain() == domain;
    }
    // 管理者：可讀取所有學校的資料（管理者彙整頁 admin.html 使用），不能修改。
    // 名單需與 config.js 的 admins 一致。
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['dfleoyang@hlhs.hlc.edu.tw', 'ponponmai@hlhs.hlc.edu.tw'];
    }

    // 學校工作區：同網域成員可建立與修改，網域不可改，不可刪除
    match /schools/{domain} {
      allow read: if sameSchool(domain);
      allow create: if sameSchool(domain)
        && request.resource.data.domain == domain
        && request.resource.data.keys().size() <= 12
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80;
      allow update: if sameSchool(domain)
        && request.resource.data.domain == resource.data.domain
        && request.resource.data.keys().size() <= 12
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80;
      allow delete: if false;

      // 診斷快照：同網域成員可新增與讀取，存下後不能修改或刪除
      match /snapshots/{snapId} {
        allow read: if sameSchool(domain);
        allow create: if sameSchool(domain)
          && request.resource.data.keys().size() <= 10
          && request.resource.data.plan in ['a1', 'a2']
          && request.resource.data.picks.size() <= 50;
      }

      // 各指標狀態、佐證註記、年度方案
      match /{kind}/{docId} {
        allow read: if sameSchool(domain);
        allow create, update: if sameSchool(domain)
          && kind in ['status', 'notes', 'picks']
          && request.resource.data.keys().size() <= 8;
        allow delete: if sameSchool(domain) && kind in ['status', 'notes', 'picks'];
      }
    }

    // 管理者可讀取全部；其他位置一律拒絕
    match /{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
